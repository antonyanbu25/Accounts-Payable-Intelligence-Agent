# secrets — never commit these
.env
*.env.local

# python
__pycache__/
*.pyc
.venv/
venv/

# db artifacts generated locally
db/seed_data.sql
db/scenario_index.txt

# chroma_db IS committed deliberately (see service/chroma_db/README.md) --
# the live server reads it read-only and never runs ingest.py itself, so the
# heavy embedding step (torch/sentence-transformers) never has to run on
# Render's memory-constrained free tier. Regenerate locally with
# `python service/ingest.py` whenever tax_docs/ changes, then re-commit.
service/extracted_metadata.json
.pytest_cache/

# confidential — marked "not for redistribution" by DevRev, never commit
DevRev_Applied-AI-Strategist_Assignment_Antony-Sagayaraj*.PDF

# misc
.DS_Store

# n8n local dev instance data (contains credentials, DB state)
n8n/data/

# streamlit local runtime -- config.toml (theme) IS committed deliberately,
# everything else in here (secrets.toml, local cache) is not.
frontend/.streamlit/*
!frontend/.streamlit/config.toml
